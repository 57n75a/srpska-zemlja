# Postgres connection string — Vercel Postgres, Neon, and Supabase
# all provide one of these in the correct format automatically.
DATABASE_URL="postgresql://user:password@host:5432/srpskazemlja"


# NextAuth core — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta (Facebook Login) — developers.facebook.com → your app → Facebook Login settings
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Apple (Sign in with Apple) — developer.apple.com → Certificates, IDs & Profiles
# APPLE_CLIENT_SECRET is not a static value — it's a JWT you generate yourself,
# signed with a private key Apple gives you, that expires after 6 months max.
# See README.md "Setting up SSO" for the exact steps.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Added when payments are wired in (not yet implemented):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
